{
  "name": "vite-plugin-fvtt",
  "version": "0.3.1",
  "description": "A Vite plugin for module and system development for Foundry VTT",
  "keywords": [
    "foundryvtt",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/MatyeusM/vite-plugin-fvtt#readme",
  "bugs": {
    "url": "https://github.com/MatyeusM/vite-plugin-fvtt/issues"
  },
  "license": "MIT",
  "author": "MatyeusM (https://github.com/MatyeusM)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatyeusM/vite-plugin-fvtt.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc",
    "test": "vitest",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.63.0",
    "rolldown": "^1.2.12",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*.ts": [
      "pnpm run lint"
    ],
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.26.0"
}
